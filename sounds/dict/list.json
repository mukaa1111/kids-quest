[
 {
  "file": "s48ec93e459.wav",
  "text": "땀이 송골송골"
 },
 {
  "file": "se493529cea.wav",
  "text": "함께 먹고 싶어."
 },
 {
  "file": "scd8c65cdd5.wav",
  "text": "급식은 짜장면이다!"
 },
 {
  "file": "s1ba8eb3d06.wav",
  "text": "하얗고 예쁜 집"
 },
 {
  "file": "s9b02cdaca0.wav",
  "text": "새끼 고양이들이었어."
 },
 {
  "file": "s256d63d4d4.wav",
  "text": "곯아떨어졌어."
 },
 {
  "file": "sd03b2030a0.wav",
  "text": "시원한 산들바람"
 },
 {
  "file": "s2e2274af2c.wav",
  "text": "찾을 수가 없어서"
 },
 {
  "file": "sb2f58a9cdd.wav",
  "text": "많이 생겼거든."
 },
 {
  "file": "sdcfc03e18e.wav",
  "text": "침대 밑의 공간에"
 },
 {
  "file": "s09252007b8.wav",
  "text": "이마에 땀이 맺혔어."
 },
 {
  "file": "s4103f61773.wav",
  "text": "하얗게 쌓인 눈"
 },
 {
  "file": "sfd977bde82.wav",
  "text": "꾸벅꾸벅 졸았어."
 },
 {
  "file": "s4fcc8b945b.wav",
  "text": "책상 밑을 찾아봐."
 },
 {
  "file": "sbe91a2457a.wav",
  "text": "친구가 많이 왔거든."
 },
 {
  "file": "s08d1116edd.wav",
  "text": "조금 매콤하고"
 },
 {
  "file": "s98351fa872.wav",
  "text": "벌써 입속에"
 },
 {
  "file": "s15d9e671b4.wav",
  "text": "단짝끼리 오순도순"
 },
 {
  "file": "s0f9de22dc2.wav",
  "text": "여우를 골탕 먹이는"
 },
 {
  "file": "s0b2fbbb2ab.wav",
  "text": "치료해 주었어."
 },
 {
  "file": "s566101b43a.wav",
  "text": "신발주머니 가방"
 },
 {
  "file": "s55b327d85c.wav",
  "text": "짜장 수염 두 가닥"
 },
 {
  "file": "se08e250ff1.wav",
  "text": "초대하지 않았어."
 },
 {
  "file": "sb5da622a8a.wav",
  "text": "망가뜨릴지도 몰라."
 },
 {
  "file": "s14195a4575.wav",
  "text": "눈처럼 하얗지 않아."
 },
 {
  "file": "s683728d8a3.wav",
  "text": "벌써 다 먹었어."
 },
 {
  "file": "sc26269cba4.wav",
  "text": "떡볶이가 매콤해."
 },
 {
  "file": "s975c589cc2.wav",
  "text": "오순도순 이야기를 나누며"
 },
 {
  "file": "se0d0237678.wav",
  "text": "연필을 부러뜨렸어."
 },
 {
  "file": "s763c8fb3e1.wav",
  "text": "숙제를 하지 않았어."
 },
 {
  "file": "sd2dc6c5b3d.wav",
  "text": "노력하는 모습"
 },
 {
  "file": "s849186daa9.wav",
  "text": "넌 잘하고 있어."
 },
 {
  "file": "s5298d5fc67.wav",
  "text": "기분이 상하지 않게"
 },
 {
  "file": "s7e3c44e571.wav",
  "text": "앞으로 자주 연락하자."
 },
 {
  "file": "s09cb9e555f.wav",
  "text": "물건이 쏟아져"
 },
 {
  "file": "sfbe756d16a.wav",
  "text": "긍정적으로 받아들이고"
 },
 {
  "file": "s8a0440f857.wav",
  "text": "끝까지 듣고"
 },
 {
  "file": "s527c5dd23e.wav",
  "text": "여쭤보면 어떨까?"
 },
 {
  "file": "s1b887b8712.wav",
  "text": "짖는 개를 보고"
 },
 {
  "file": "s9efab9aae2.wav",
  "text": "상황에 맞는 말을"
 },
 {
  "file": "sd325ae8f97.wav",
  "text": "서로 존중하는 마음"
 },
 {
  "file": "s12f5587b31.wav",
  "text": "끝까지 포기하지 않고"
 },
 {
  "file": "scbf4664b2d.wav",
  "text": "할머니께 여쭤보았어."
 },
 {
  "file": "s41e7dc155c.wav",
  "text": "물을 쏟았어."
 },
 {
  "file": "scec2dd1a0c.wav",
  "text": "알맞은 말을 골라요."
 },
 {
  "file": "sc9e2216107.wav",
  "text": "촐랑대는 너를 보면"
 },
 {
  "file": "s7e4b0e10e7.wav",
  "text": "넷이서 하면"
 },
 {
  "file": "sb80188a05f.wav",
  "text": "어제부터 머리가 좀 아파."
 },
 {
  "file": "s047bb954b1.wav",
  "text": "상대의 말을 공감하며"
 },
 {
  "file": "s2f626496f5.wav",
  "text": "나랑 축구할래?"
 },
 {
  "file": "s5a47990921.wav",
  "text": "어려움이 있을 때"
 },
 {
  "file": "se05eb8c175.wav",
  "text": "너한테 어울리는 색으로"
 },
 {
  "file": "s9ca57ea1d8.wav",
  "text": "시력이 좋아질 수 있어."
 },
 {
  "file": "s2a24d2ab90.wav",
  "text": "어젯밤에 무서운 꿈을"
 },
 {
  "file": "se0677a980c.wav",
  "text": "물건을 머리맡에 두고"
 },
 {
  "file": "s44cde780bd.wav",
  "text": "셋이서 함께 놀자."
 },
 {
  "file": "s5971a93152.wav",
  "text": "배가 아파서 누웠어."
 },
 {
  "file": "sd224f1bd4c.wav",
  "text": "나랑 같이 갈래?"
 },
 {
  "file": "sf7b41ca645.wav",
  "text": "친구의 마음을 헤아리며"
 },
 {
  "file": "s684c170dd2.wav",
  "text": "잘 어울리는 옷을 골랐어."
 }
]