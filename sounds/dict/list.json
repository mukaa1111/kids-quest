[
 {
  "file": "s5962b2ffe1.wav",
  "text": "강아지가 멍멍 짖어요."
 },
 {
  "file": "sb7bc35fda7.wav",
  "text": "비가 주룩주룩 내려요."
 },
 {
  "file": "s5ebdf767c5.wav",
  "text": "토끼가 깡충깡충 뛰어요."
 },
 {
  "file": "s447d86866f.wav",
  "text": "바람이 솔솔 불어요."
 },
 {
  "file": "s2d560c9e22.wav",
  "text": "시계가 똑딱똑딱 소리를 내요."
 },
 {
  "file": "s7728fad2a9.wav",
  "text": "아기가 방긋 웃어요."
 },
 {
  "file": "sfac3c3b616.wav",
  "text": "나뭇잎이 살랑살랑 흔들려요."
 },
 {
  "file": "s8b2650526e.wav",
  "text": "개구리가 폴짝 뛰었어요."
 },
 {
  "file": "s7c2e593252.wav",
  "text": "냄비가 보글보글 끓어요."
 },
 {
  "file": "s2889b2e00c.wav",
  "text": "별이 반짝반짝 빛나요."
 },
 {
  "file": "s202dc4c32a.wav",
  "text": "어제 할머니 댁에 갔어요."
 },
 {
  "file": "s0326caa523.wav",
  "text": "아침에 일찍 일어났어요."
 },
 {
  "file": "sd5a1716deb.wav",
  "text": "점심에 김밥을 먹었어요."
 },
 {
  "file": "saec4fe35b5.wav",
  "text": "저녁에 가족과 산책했어요."
 },
 {
  "file": "s06c902bd0a.wav",
  "text": "내일은 비가 온대요."
 },
 {
  "file": "s359de31524.wav",
  "text": "지난주에 동생이 태어났어요."
 },
 {
  "file": "sc94718e5dc.wav",
  "text": "방학 때 바다에 갔어요."
 },
 {
  "file": "sed59283ab4.wav",
  "text": "밤에는 별이 보여요."
 },
 {
  "file": "sfaf5de856a.wav",
  "text": "오늘 아침 날씨가 맑아요."
 },
 {
  "file": "s0792893a39.wav",
  "text": "주말에 놀이공원에 갔어요."
 },
 {
  "file": "sb717168aef.wav",
  "text": "와, 정말 멋지다!"
 },
 {
  "file": "scb6e259bc2.wav",
  "text": "이게 누구 모자일까?"
 },
 {
  "file": "s72797f6fe9.wav",
  "text": "어머, 깜짝이야!"
 },
 {
  "file": "s304bc8f22d.wav",
  "text": "왜 늦게 왔니?"
 },
 {
  "file": "s346b9c7be0.wav",
  "text": "우아, 무지개가 떴다!"
 },
 {
  "file": "s92dc8575b4.wav",
  "text": "어디에서 만날까?"
 },
 {
  "file": "sd29582781c.wav",
  "text": "아이코, 넘어질 뻔했네!"
 },
 {
  "file": "sebba0045ec.wav",
  "text": "무엇을 먹고 싶니?"
 },
 {
  "file": "s92577ab447.wav",
  "text": "야호, 신난다!"
 },
 {
  "file": "sb9f934aea1.wav",
  "text": "몇 시에 끝나요?"
 },
 {
  "file": "s043ef6eaaa.wav",
  "text": "도와줘서 고마워."
 },
 {
  "file": "s1a51a9f287.wav",
  "text": "늦어서 미안해."
 },
 {
  "file": "sc038cebaf7.wav",
  "text": "네가 있어서 든든해."
 },
 {
  "file": "sdfcbbb6b27.wav",
  "text": "생일 축하해!"
 },
 {
  "file": "scc6ad47c44.wav",
  "text": "괜찮아, 다시 하면 돼."
 },
 {
  "file": "s364800161c.wav",
  "text": "같이 놀아서 즐거웠어."
 },
 {
  "file": "s95efaf6c10.wav",
  "text": "네 그림이 참 예쁘다."
 },
 {
  "file": "s3d1f3fa0bf.wav",
  "text": "힘내, 넌 할 수 있어."
 },
 {
  "file": "s70fe22d379.wav",
  "text": "함께해서 행복해요."
 },
 {
  "file": "se21b660491.wav",
  "text": "친구야, 사랑해."
 },
 {
  "file": "s3a2775593c.wav",
  "text": "숲속에 작은 오두막이 있었어요."
 },
 {
  "file": "sd281a011bf.wav",
  "text": "호랑이가 어흥 하고 나타났어요."
 },
 {
  "file": "sebc65d8fec.wav",
  "text": "공주는 성 안에서 살았어요."
 },
 {
  "file": "sd6d50b59a5.wav",
  "text": "바닷속에 인어가 헤엄쳐요."
 },
 {
  "file": "s3d9aad79ca.wav",
  "text": "달님이 구름 뒤에 숨었어요."
 },
 {
  "file": "s51f308e29c.wav",
  "text": "마법사가 지팡이를 흔들었어요."
 },
 {
  "file": "sb255562eef.wav",
  "text": "용은 불을 뿜었어요."
 },
 {
  "file": "sa0750a9f04.wav",
  "text": "거북이가 느릿느릿 기어가요."
 },
 {
  "file": "s31aee4c961.wav",
  "text": "요정이 반짝이는 가루를 뿌렸어요."
 },
 {
  "file": "sf11aeab03c.wav",
  "text": "아이들은 보물 상자를 열었어요."
 },
 {
  "file": "s24425c40ff.wav",
  "text": "창문을 닫아 주세요."
 },
 {
  "file": "sb97a4ef455.wav",
  "text": "오늘은 비가 옵니다."
 },
 {
  "file": "s3f64fab3cf.wav",
  "text": "우리 같이 가자."
 },
 {
  "file": "s27d4850beb.wav",
  "text": "정말 재미있구나!"
 },
 {
  "file": "s349c48f3b1.wav",
  "text": "숙제를 다 했습니까?"
 },
 {
  "file": "s7e4e704e55.wav",
  "text": "조용히 책을 읽어라."
 },
 {
  "file": "s2a591ec32f.wav",
  "text": "나는 학교에 갑니다."
 },
 {
  "file": "s2250e1bf79.wav",
  "text": "손을 깨끗이 씻자."
 },
 {
  "file": "s3808b3e42f.wav",
  "text": "저 꽃은 무슨 꽃입니까?"
 },
 {
  "file": "s5cf5705c05.wav",
  "text": "어서 빨리 뛰어라!"
 },
 {
  "file": "sdadd246ca9.wav",
  "text": "할아버지께서 오셨어요."
 },
 {
  "file": "s173c6f23bb.wav",
  "text": "선생님께 편지를 드렸어요."
 },
 {
  "file": "sc89678cd68.wav",
  "text": "할머니께서 진지를 잡수세요."
 },
 {
  "file": "s5247aa7f0f.wav",
  "text": "어머니께 여쭤보았어요."
 },
 {
  "file": "s5cd066456e.wav",
  "text": "아버지께서 주무세요."
 },
 {
  "file": "s2d0d1805e9.wav",
  "text": "할머니, 안녕히 주무셨어요?"
 },
 {
  "file": "s293e5a123a.wav",
  "text": "선생님께서 말씀하셨어요."
 },
 {
  "file": "s7c8a151914.wav",
  "text": "이모께 선물을 드릴 거예요."
 },
 {
  "file": "s4e04105ae5.wav",
  "text": "할아버지께서 연세가 많으세요."
 },
 {
  "file": "sb5d279c8b8.wav",
  "text": "손님을 모시고 왔어요."
 },
 {
  "file": "s536ff1fd99.wav",
  "text": "며칠 뒤에 소풍을 가요."
 },
 {
  "file": "s26fd60986c.wav",
  "text": "엄마가 설거지를 해요."
 },
 {
  "file": "s8aaf7eea97.wav",
  "text": "눈이 금세 녹았어요."
 },
 {
  "file": "s045d3f41d2.wav",
  "text": "오랜만에 삼촌을 만났어요."
 },
 {
  "file": "s2a3d148af8.wav",
  "text": "이제 어떡해!"
 },
 {
  "file": "s3814641a20.wav",
  "text": "이게 웬일이야?"
 },
 {
  "file": "sc1b346ffd1.wav",
  "text": "방을 깨끗이 치웠어요."
 },
 {
  "file": "s911acb7b73.wav",
  "text": "내일 꼭 할게요."
 },
 {
  "file": "sbdf896f4e0.wav",
  "text": "곰곰이 생각해 보았어요."
 },
 {
  "file": "s16a221839c.wav",
  "text": "약속을 잊어버렸어요."
 },
 {
  "file": "s246b3763e9.wav",
  "text": "뉴스에서 날씨를 알려 줘요."
 },
 {
  "file": "s12f3bf3f59.wav",
  "text": "광고에는 그림이 많아요."
 },
 {
  "file": "s713e9a28a1.wav",
  "text": "내 생각에는 공원이 좋아요."
 },
 {
  "file": "sf1dcfc3b5f.wav",
  "text": "왜냐하면 꽃이 많기 때문이에요."
 },
 {
  "file": "sf3e6ec3b49.wav",
  "text": "친구의 의견을 들어요."
 },
 {
  "file": "s3c2ce6731c.wav",
  "text": "사진을 보고 이야기해요."
 },
 {
  "file": "sc125362a7e.wav",
  "text": "책 표지에 제목이 있어요."
 },
 {
  "file": "s66ae20c962.wav",
  "text": "영상을 보고 느낌을 말해요."
 },
 {
  "file": "s240efbf84e.wav",
  "text": "저는 찬성해요."
 },
 {
  "file": "s2a16d989fe.wav",
  "text": "이유를 말해 주세요."
 },
 {
  "file": "s998c643aa4.wav",
  "text": "나는 숲으로 가서 다람쥐를 보았어요."
 },
 {
  "file": "s99e0443713.wav",
  "text": "비가 와서 우산을 썼어요."
 },
 {
  "file": "sc0464f3f79.wav",
  "text": "배가 고파서 떡볶이를 먹었어요."
 },
 {
  "file": "s7d26823a32.wav",
  "text": "그런데 갑자기 번개가 쳤어요."
 },
 {
  "file": "s457ccbae2c.wav",
  "text": "그래서 집으로 뛰어갔어요."
 },
 {
  "file": "sf9e628d34a.wav",
  "text": "할머니는 옛날이야기를 들려주셨어요."
 },
 {
  "file": "sb177ded828.wav",
  "text": "끝으로 모두 행복하게 살았어요."
 },
 {
  "file": "s976a3b19b9.wav",
  "text": "주인공은 용감한 소년이에요."
 },
 {
  "file": "s4db387a4c2.wav",
  "text": "내가 만든 이야기를 읽어 주었어요."
 },
 {
  "file": "s3f404a8817.wav",
  "text": "친구들이 박수를 쳤어요."
 },
 {
  "file": "sb510063206.wav",
  "text": "숙제를 다 했어요."
 },
 {
  "file": "s3704f98d0d.wav",
  "text": "오늘은 날씨가 참 좋아요."
 },
 {
  "file": "s647ca1c5fb.wav",
  "text": "나는 숟가락으로 밥을 먹어요."
 },
 {
  "file": "s39d641c01d.wav",
  "text": "젓가락으로 반찬을 집어요."
 },
 {
  "file": "sf1b2c75cc8.wav",
  "text": "김치찌개가 맛있어요."
 },
 {
  "file": "sbf6b6828d7.wav",
  "text": "꽃잎이 바람에 날려요."
 },
 {
  "file": "sbb2dcd0edd.wav",
  "text": "무릎이 아파요."
 },
 {
  "file": "s34e05268c4.wav",
  "text": "부엌에서 요리를 해요."
 },
 {
  "file": "s17132f34c6.wav",
  "text": "닭이 알을 낳았어요."
 },
 {
  "file": "sd8531549fd.wav",
  "text": "이 책은 값이 싸요."
 },
 {
  "file": "s9e3a5fb766.wav",
  "text": "돌멩이를 주웠어요."
 },
 {
  "file": "s24a939812e.wav",
  "text": "동생은 개구쟁이예요."
 },
 {
  "file": "se895606401.wav",
  "text": "엄마 심부름을 다녀왔어요."
 },
 {
  "file": "s2355d270d6.wav",
  "text": "선생님이 한글을 가르쳐요."
 },
 {
  "file": "s0c0f4b83de.wav",
  "text": "손가락으로 별을 가리켰어요."
 },
 {
  "file": "s7d6839ead5.wav",
  "text": "우산을 잃어버렸어요."
 },
 {
  "file": "sfecf41e70d.wav",
  "text": "안녕히 가세요."
 },
 {
  "file": "s70bd2ff2cf.wav",
  "text": "깍두기를 담갔어요."
 },
 {
  "file": "sd93593d96b.wav",
  "text": "두꺼비가 폴짝 뛰어요."
 },
 {
  "file": "s72720d58cf.wav",
  "text": "갑자기 소나기가 내려요."
 },
 {
  "file": "s34c2273ccc.wav",
  "text": "햇빛이 눈부셔요."
 },
 {
  "file": "s026fa6bcbe.wav",
  "text": "의자에 앉았어요."
 },
 {
  "file": "sbe25ba59ff.wav",
  "text": "책을 많이 읽었어요."
 },
 {
  "file": "s64b91257f8.wav",
  "text": "하늘이 파랗다."
 },
 {
  "file": "s0860dec83e.wav",
  "text": "눈이 하얗게 쌓였어요."
 },
 {
  "file": "s7a05b37316.wav",
  "text": "굳이 안 가도 돼요."
 },
 {
  "file": "sa10d13f2ef.wav",
  "text": "해돋이를 보러 갔어요."
 },
 {
  "file": "s1f6453d761.wav",
  "text": "공을 멀리 던졌어요."
 },
 {
  "file": "sd02d291eb6.wav",
  "text": "강아지가 꼬리를 흔들어요."
 },
 {
  "file": "sfff9b1d763.wav",
  "text": "맛있는 빵을 먹었어요."
 },
 {
  "file": "se76bed75d7.wav",
  "text": "물이 끓고 있어요."
 },
 {
  "file": "s7c4197eeae.wav",
  "text": "연필을 깎았어요."
 },
 {
  "file": "s9cbaa49de3.wav",
  "text": "어떻게 하면 좋을까?"
 },
 {
  "file": "sbea1f507f6.wav",
  "text": "공부를 열심히 했어요."
 },
 {
  "file": "sb4dc22998c.wav",
  "text": "형이 나보다 키가 커요."
 },
 {
  "file": "sa44378bd1a.wav",
  "text": "창문을 닫았어요."
 },
 {
  "file": "sfb17893ab8.wav",
  "text": "나는 그네를 좋아해요."
 },
 {
  "file": "s382cae5cfa.wav",
  "text": "오랜만에 할머니를 만났어요."
 }
]